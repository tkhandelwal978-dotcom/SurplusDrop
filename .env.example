# Copy to .env for the apps. MCP variables below must ALSO be exported in your shell
# (e.g. in ~/.zshrc or via direnv) because Claude Code expands ${VAR} in .mcp.json from the shell.

# --- MCP servers (developer machine only) ---
GITHUB_PAT=                # fine-grained token: this repo only, issues + pull requests
STITCH_API_KEY=            # from stitch.withgoogle.com project settings
LOCAL_DB_READONLY_URL=postgres://sd_readonly:sd_readonly@localhost:5432/surplusdrop

# --- Application (local) ---
DATABASE_URL=postgres://surplusdrop:surplusdrop@localhost:5432/surplusdrop
REDIS_URL=redis://localhost:6379
PUBLIC_WEB_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
